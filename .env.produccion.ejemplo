# Configuración del servidor de producción. Copie este archivo como .env en la misma carpeta que
# docker-compose.produccion.yml y cambie TODOS los valores marcados como obligatorios.
#
#   cp .env.produccion.ejemplo .env && chmod 600 .env
#
# Este archivo lo lee docker compose para resolver las ${VARIABLES} del compose; no se copia
# dentro de la imagen ni se monta en los contenedores.
#
# Aquí solo va configuración de la PLATAFORMA. Lo que varía por empresa (colores, moneda, plazos,
# límites, formas de pago, plan contratado) vive en empresa_marca y empresa_config y se cambia
# desde la propia aplicación, nunca aquí.

# ─────────────────────────────── OBLIGATORIAS ───────────────────────────────

# Contraseña del superusuario de PostgreSQL. Se usa solo para administrar (respaldos, restauración).
# Generar con:  openssl rand -base64 32
POSTGRES_PASSWORD=CAMBIAR

# Contraseña del rol cxc_app, con el que se conecta la aplicación.
# Viaja dentro de una URL (postgres://cxc_app:ESTA@postgres:5432/cxc), así que conviene generarla
# sin caracteres que haya que escapar:
#   openssl rand -base64 48 | tr -dc 'A-Za-z0-9' | head -c 40
CXC_APP_PASSWORD=CAMBIAR

# Nombres por los que se entra al sistema, separados por espacios. Caddy pide un certificado por
# cada uno, así que todos deben apuntar por DNS a este servidor.
# El primero es el dominio base; los demás son los subdominios de cada empresa cliente
# (el slug de la empresa + el dominio base).
# Al dar de alta una empresa nueva se agrega su subdominio aquí y se recarga Caddy.
DOMINIOS=cobros.ejemplo.sv distribuidora-progreso.cobros.ejemplo.sv

# Dominio base para resolver la empresa por subdominio: una petición a
# distribuidora-progreso.cobros.ejemplo.sv pertenece a la empresa con ese slug.
# Si no coincide con la empresa de la sesión, la API responde 403 EMPRESA_NO_COINCIDE.
# Vacío = resolución por subdominio deshabilitada (la empresa sale solo de la sesión).
DOMINIO_BASE=cobros.ejemplo.sv

# Correo al que Let's Encrypt avisa si un certificado no se puede renovar. Que sea uno que alguien
# lea: es el único aviso antes de que el sitio quede sin HTTPS.
EMAIL_ADMIN=operaciones@ejemplo.sv

# Versión que se construye y se corre. Se compila dentro del binario, la devuelve /api/salud y
# etiqueta la imagen (cxc:2026.10.17), que es lo que permite volver a la anterior sin recompilar.
# Conviene usar la fecha del despliegue.
VERSION=2026.10.17
