# Copie este archivo como .env y ajuste los valores. La aplicación lee .env al arrancar, pero las
# variables ya definidas en el entorno tienen prioridad sobre el archivo.
#
# Aquí solo va configuración de la PLATAFORMA. Todo lo que varía por empresa (colores, moneda,
# plazos, umbrales...) vive en las tablas empresa_marca y empresa_config y se cambia por API.

# Puerto HTTP de la API.
PUERTO=8080

# Conexión a PostgreSQL. Debe usar un rol SIN superusuario ni BYPASSRLS (la app no arranca si no).
# Este valor coincide con docker-compose.yml y es el que se usa por defecto en dev si se omite.
DATABASE_URL=postgres://cxc_app:cxc_app_dev@localhost:5433/cxc?sslmode=disable

# dev  -> aplica migraciones/002_seed_desarrollo.sql, imprime credenciales, cookie sin Secure.
# otro -> no siembra datos, cookie con Secure y DATABASE_URL obligatoria.
ENTORNO=dev

# Opcional. Si se define (ej. cobros.app), una petición a abarroteria-lopez.cobros.app debe
# pertenecer a la empresa con slug abarroteria-lopez; si no coincide con la sesión, responde 403.
# Vacío = resolución por subdominio deshabilitada (solo sesión + header X-Empresa-Slug).
DOMINIO_BASE=
